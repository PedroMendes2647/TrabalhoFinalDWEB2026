@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Ocorreu um erro!</h4>
                <p>
                    Uma solicitação inesperada foi processada pelo servidor.
                </p>
                @if (Model.ShowRequestId)
                {
                    <hr />
                    <p>
                        <strong>ID de Pedido:</strong> <code>@Model.RequestId</code>
                    </p>
                }
            </div>
            <a href="/" class="btn btn-primary">Voltar à Página Inicial</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Qualquer script específico do tratamento de erros pode ser adicionado aqui
    </script>
}
