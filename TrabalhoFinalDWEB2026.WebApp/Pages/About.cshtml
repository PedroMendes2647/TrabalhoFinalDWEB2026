@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.AboutModel
@{
    ViewData["Title"] = "Acerca de";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">Acerca de TrabalhoFinalDWEB2026</h1>

            <!-- Informações do Projeto -->
            <section class="mb-5">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Informações do Projeto</h5>
                    </div>
                    <div class="card-body">
                        <p>
                            <strong>Disciplina:</strong> Desenvolvimento Web
                        </p>
                        <p>
                            <strong>Ano Letivo:</strong> 2025/2026
                        </p>
                        <p>
                            <strong>Licenciatura:</strong> Engenharia Informática (2º ano, 2º semestre)
                        </p>
                        <p>
                            <strong>Tema:</strong> Sistema de Gestão de Receitas Farmacêuticas
                        </p>
                        <hr />
                        <p>
                            <strong>Autores:</strong>
                        </p>
                        <ul>
                            <li>Nome do Aluno 1 - Número de Aluno</li>
                            <li>Nome do Aluno 2 - Número de Aluno</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- Funcionalidades -->
            <section class="mb-5">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Funcionalidades da Aplicação</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold">Para Utentes (Pacientes):</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li>Visualizar receitas prescritas</li>
                                    <li>Visualizar medicamentos associados às receitas</li>
                                    <li>Consultar histórico de receitas</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                            </div>
                        </div>

                        <h6 class="fw-bold mt-4">Para Doutores:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li>Pesquisar utilizadores</li>
                                    <li>Visualizar dados de utilizadores</li>
                                    <li>Criar receitas para utilizadores</li>
                                    <li>Associar medicamentos às receitas</li>
                                </ul>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Para Farmacêuticos:</h6>
                                <ul>
                                    <li>Visualizar receitas emitidas</li>
                                    <li>Dispensar/avisar receitas</li>
                                    <li>Pesquisar receitas por ID ou utilizador</li>
                                    <li>Histórico de receitas dispensadas</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">API REST:</h6>
                                <ul>
                                    <li>CRUD completo de medicamentos</li>
                                    <li>CRUD completo de receitas</li>
                                    <li>Endpoints em <code>/api/medicamentosapi</code></li>
                                    <li>Endpoints em <code>/api/receitasapi</code></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tecnologias Utilizadas -->
            <section class="mb-5">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Tecnologias Utilizadas</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Backend:</h6>
                                <ul>
                                    <li>ASP.NET Core 10.0</li>
                                    <li>Entity Framework Core</li>
                                    <li>Microsoft SQL Server</li>
                                    <li>ASP.NET Core Identity</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">Frontend:</h6>
                                <ul>
                                    <li>Razor Pages</li>
                                    <li>HTML5</li>
                                    <li>CSS3 (Bootstrap 5)</li>
                                    <li>JavaScript</li>
                                    <li>jQuery</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Arquitetura da Aplicação -->
            <section class="mb-5">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Arquitetura da Aplicação</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Estrutura de Camadas:</h6>
                        <ul>
                            <li><strong>Camada de Apresentação:</strong> Vistas Razor Pages</li>
                            <li><strong>Camada de Lógica de Negócio:</strong> PageModels</li>
                            <li><strong>Camada de Dados:</strong> Entity Framework Core com SQL Server</li>
                            <li><strong>Camada de Modelos:</strong> Entidades de Domínio (Models)</li>
                            <li><strong>Camada de API:</strong> Controladores API REST</li>
                        </ul>

                        <h6 class="fw-bold mt-4 mb-3">Padrões Implementados:</h6>
                        <ul>
                            <li><strong>Razor Pages:</strong> Separação de responsabilidades entre modelo e vista</li>
                            <li><strong>Repository Pattern:</strong> Entity Framework Core atua como abstração de dados</li>
                            <li><strong>Dependency Injection:</strong> Injeção de dependências no ASP.NET Core</li>
                            <li><strong>Role-Based Authorization:</strong> Controlo de acesso baseado em papéis</li>
                        </ul>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: none;
    }

    .card-header {
        font-weight: 600;
        border-bottom: 2px solid rgba(0, 0, 0, 0.125);
    }

    code {
        background-color: #f8f9fa;
        padding: 0.2rem 0.5rem;
        border-radius: 0.25rem;
        font-family: 'Courier New', monospace;
    }

    section {
        scroll-margin-top: 100px;
    }
</style>
