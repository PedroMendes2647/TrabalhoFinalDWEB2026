@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.Management.ViewReceitasModel
@using TrabalhoFinalDWEB2026.WebApp.Models
@{
    ViewData["Title"] = "Receitas";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="bi bi-file-earmark-text"></i> Todas as Receitas
            </h1>

            @if (Model.Receitas != null && Model.Receitas.Count > 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    Existem <strong>@Model.Receitas.Count</strong> receita(s) no sistema.
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>ID Receita</th>
                                <th>Utente</th>
                                <th>Nº Utente</th>
                                <th>Doutor</th>
                                <th>Data Emissão</th>
                                <th>Estado</th>
                                <th>Nº Medicamentos</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var receita in Model.Receitas)
                            {
                                <tr>
                                    <td><strong>#@receita.Id</strong></td>
                                    <td>@receita.Utente?.Nome</td>
                                    <td>@receita.Utente?.NumeroUtente</td>
                                    <td>@receita.DoutorUtente?.Nome</td>
                                    <td>@receita.DataEmissao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (receita.Estado == Receita.State.Emitida)
                                        {
                                            <span class="badge bg-warning text-dark">Emitida</span>
                                        }
                                        else if (receita.Estado == Receita.State.Aviada)
                                        {
                                            <span class="badge bg-success">Aviada</span>
                                        }
                                        else if (receita.Estado == Receita.State.Expirada)
                                        {
                                            <span class="badge bg-secondary">Expirada</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @(receita.ListaDeMedicamentos?.Count ?? 0)
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-page="/Management/ReceitaDetails" asp-route-id="@receita.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center py-5">
                    <h4><i class="bi bi-inbox"></i> Sem Receitas</h4>
                    <p>Não há receitas no sistema.</p>
                </div>
            }

            <div class="mt-4">
                <a asp-page="/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>
</div>
