@page "{id}"
@model TrabalhoFinalDWEB2026.WebApp.Pages.Management.ReceitaDetailsModel
@using TrabalhoFinalDWEB2026.WebApp.Models
@{
    ViewData["Title"] = "Detalhes da Receita";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-12">
            @if (Model.Receita != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h3 class="mb-0">Receita #@Model.Receita.Id</h3>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Informações do Utente</h6>
                                <p>
                                    <strong>Nome:</strong> @Model.Receita.Utente?.Nome<br />
                                    <strong>Número de Utente:</strong> @Model.Receita.Utente?.NumeroUtente<br />
                                    <strong>E-mail:</strong> @Model.Receita.Utente?.Email
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">Informações da Receita</h6>
                                <p>
                                    <strong>Estado:</strong>
                                    @if (Model.Receita.Estado == Receita.State.Emitida)
                                    {
                                        <span class="badge bg-warning text-dark">Emitida</span>
                                    }
                                    else if (Model.Receita.Estado == Receita.State.Aviada)
                                    {
                                        <span class="badge bg-success">Aviada</span>
                                    }
                                    else if (Model.Receita.Estado == Receita.State.Expirada)
                                    {
                                        <span class="badge bg-secondary">Expirada</span>
                                    }
                                    <br />
                                    <strong>Data de Emissão:</strong> @Model.Receita.DataEmissao.ToString("dd/MM/yyyy HH:mm")<br />
                                    @if (Model.Receita.DataDispensacao.HasValue)
                                    {
                                        <strong>Data de Dispensação:</strong> @Model.Receita.DataDispensacao.Value.ToString("dd/MM/yyyy HH:mm")<br />
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Doutor Prescritor</h6>
                                <p>@Model.Receita.DoutorUtente?.Nome</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">Farmacêutico Dispensador</h6>
                                <p>
                                    @if (!string.IsNullOrEmpty(Model.Receita.FarmaceutaId))
                                    {
                                        @Model.Receita.FarmaceutaUtente?.Nome
                                    }
                                    else
                                    {
                                        <em class="text-muted">Aguardando dispensação</em>
                                    }
                                </p>
                            </div>
                        </div>

                        <hr />

                        <h6 class="fw-bold mb-3">Medicamentos Prescritos</h6>
                        @if (Model.Receita.ListaDeMedicamentos != null && Model.Receita.ListaDeMedicamentos.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Medicamento</th>
                                            <th>Dosagem</th>
                                            <th>Quantidade</th>
                                            <th>Posologia</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var rm in Model.Receita.ListaDeMedicamentos)
                                        {
                                            <tr>
                                                <td><strong>@rm.Medicamento?.Nome</strong></td>
                                                <td>@rm.Medicamento?.Dosagem</td>
                                                <td>@rm.Quantidade</td>
                                                <td>@rm.Posologia</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Sem medicamentos associados.</p>
                        }

                        <hr />

                        <div class="d-flex gap-2">
                            <a asp-page="ViewReceitas" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <p>Receita não encontrada.</p>
                    <a asp-page="ViewReceitas" class="btn btn-secondary">Voltar</a>
                </div>
            }
        </div>
    </div>
</div>
