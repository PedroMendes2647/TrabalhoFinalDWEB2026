@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.Management.ViewMedicamentosModel
@using TrabalhoFinalDWEB2026.WebApp.Models
@{
    ViewData["Title"] = "Medicamentos Disponíveis";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">
                <i class="bi bi-capsule"></i> Medicamentos Disponíveis
            </h1>

            @if (Model.Medicamentos != null && Model.Medicamentos.Count > 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    Existem <strong>@Model.Medicamentos.Count</strong> medicamento(s) disponível(is) no sistema.
                </div>

                <div class="row">
                    @foreach (var medicamento in Model.Medicamentos)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold">
                                        <i class="bi bi-pill"></i> @medicamento.Nome
                                    </h6>
                                    <p class="card-text">
                                        <strong>Dosagem:</strong> @medicamento.Dosagem<br />
                                        <strong>Tipo:</strong> <small class="text-muted">@(string.IsNullOrEmpty(medicamento.Tipo) ? "N/A" : medicamento.Tipo)</small><br />
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-success">ID: @medicamento.Id</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center py-5">
                    <h4><i class="bi bi-inbox"></i> Sem Medicamentos</h4>
                    <p>Não há medicamentos registados no sistema.</p>
                </div>
            }

            <div class="mt-4">
                <a asp-page="/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>
</div>
