@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.Farmaceuta.SearchModel
@using TrabalhoFinalDWEB2026.WebApp.Models
@{
    ViewData["Title"] = "Pesquisar Receita";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-search"></i> Pesquisar Receita
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="searchQuery" class="form-label">Pesquisar por ID da Receita ou Nº de Utente</label>
                            <input type="text" class="form-control form-control-lg" id="searchQuery" name="searchQuery" 
                                   placeholder="Ex: 1 (ID) ou 123456789 (Nº Utente)" required />
                            <small class="form-text text-muted">
                                Pode procurar por um ID de receita específico ou pelo número de utente para listar todas as suas receitas.
                            </small>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <div class="alert alert-danger">@error.ErrorMessage</div>
                                }
                            }
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Pesquisar
                            </button>
                            <a asp-page="Dashboard" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
