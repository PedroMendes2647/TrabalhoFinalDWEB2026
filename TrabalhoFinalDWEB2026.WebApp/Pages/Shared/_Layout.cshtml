<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Receitas Farmacêuticas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrabalhoFinalDWEB2026.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">Receitas Farmacêuticas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/About">Acerca de</a>
                        </li>
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <a class="nav-link text-dark" asp-page="/Dashboard/Index">Dashboard</a>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-page="/Account/Login">Dashboard</a>
                            }
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/MyAccount/MyData">Meus Dados</a></li>
                                    <li><a class="dropdown-item" asp-page="/MyAccount/MyReceitas">Minhas Receitas</a></li>
                                    <li><a class="dropdown-item" asp-page="/MyAccount/ChangePassword">Alterar Palavra-passe</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout" style="display: inline;">
                                            <button type="submit" class="dropdown-item text-danger">Terminar Sessão</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Account/Login">Iniciar Sessão</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contentor global para alertas SignalR Toast -->
    <div aria-live="polite" aria-atomic="true" class="position-relative">
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 11000;" id="toastContainer"></div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TrabalhoFinalDWEB2026 - <a asp-page="/About">Acerca de</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Inicialização global da ligação SignalR
        window.receitaConnection = new signalR.HubConnectionBuilder()
            .withUrl("/receitaHub")
            .withAutomaticReconnect()
            .build();

        window.receitaConnection.on("NotificacaoReceita", function (mensagem, titulo) {
            const container = document.getElementById("toastContainer");
            if (!container) return;

            const toastEl = document.createElement("div");
            toastEl.className = "toast align-items-center text-bg-primary border-0 show mb-2 shadow";
            toastEl.setAttribute("role", "alert");
            toastEl.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <strong>${titulo || 'Notificação'}</strong><br/>
                        ${mensagem}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            container.appendChild(toastEl);
            setTimeout(() => toastEl.remove(), 7000);
        });

        window.receitaConnection.start().catch(err => console.error("Erro SignalR: ", err));
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
