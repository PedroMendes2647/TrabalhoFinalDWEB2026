@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registar";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-4">Criar Conta</h2>

                    <form method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="NumeroUtente" class="form-label">Número de Utente</label>
                                <input class="form-control" type="text" asp-for="Input.NumeroUtente" placeholder="Ex: 123456789" />
                                <span asp-validation-for="Input.NumeroUtente" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="Email" class="form-label">E-mail</label>
                                <input class="form-control" type="email" asp-for="Input.Email" placeholder="Ex: exemplo@email.com" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Nome" class="form-label">Nome Completo</label>
                            <input class="form-control" type="text" asp-for="Input.Nome" placeholder="Insira o seu nome completo" />
                            <span asp-validation-for="Input.Nome" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="DataNascimento" class="form-label">Data de Nascimento</label>
                            <input class="form-control" type="date" asp-for="Input.DataNascimento" />
                            <span asp-validation-for="Input.DataNascimento" class="text-danger"></span>
                            <small class="text-muted">Deve ter pelo menos 13 anos para se registar.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Password" class="form-label">Palavra-passe</label>
                                <input class="form-control" type="password" asp-for="Input.Password" placeholder="Insira uma palavra-passe" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="ConfirmPassword" class="form-label">Confirmar Palavra-passe</label>
                                <input class="form-control" type="password" asp-for="Input.ConfirmPassword" placeholder="Confirme a palavra-passe" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Registar</button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center">
                        Já tem conta? <a asp-page="./Login">Iniciar Sessão aqui</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
