@page
@model TrabalhoFinalDWEB2026.WebApp.Pages.MyAccount.EditPerfilModel
@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Editar Perfil
                    </h3>
                </div>
                <div class="card-body">
                    @if (Model.CurrentUser != null)
                    {
                        <form method="post">
                            <input type="hidden" name="id" value="@Model.CurrentUser.Id" />

                            <div class="mb-3">
                                <label for="numeroUtente" class="form-label">Número de Utente</label>
                                <input type="text" class="form-control" id="numeroUtente" 
                                       value="@Model.CurrentUser.NumeroUtente" disabled />
                                <small class="form-text text-muted">Este campo não pode ser alterado.</small>
                            </div>

                            <div class="mb-3">
                                <label for="nome" class="form-label">Nome Completo</label>
                                <input type="text" class="form-control" id="nome" name="nome" 
                                       value="@Model.CurrentUser.Nome" required />
                                <span asp-validation-for="CurrentUser.Nome" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">E-mail</label>
                                <input type="email" class="form-control" id="email" name="email" 
                                       value="@Model.CurrentUser.Email" required />
                                <span asp-validation-for="CurrentUser.Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label for="dataNascimento" class="form-label">Data de Nascimento</label>
                                <input type="date" class="form-control" id="dataNascimento" name="dataNascimento" 
                                       value="@Model.CurrentUser.DataNascimento.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="CurrentUser.DataNascimento" class="text-danger"></span>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    @foreach (var error in modelState.Errors)
                                    {
                                        <div class="alert alert-danger">
                                            @error.ErrorMessage
                                        </div>
                                    }
                                }
                            }

                            <hr />

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Guardar Alterações
                                </button>
                                <a asp-page="MyData" class="btn btn-secondary">Cancelar</a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <p>Não foi possível carregar os seus dados. Por favor, tente novamente mais tarde.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
